# -------------------------
# LLM CONFIG
# -------------------------

# Optional: Specify the configuration key from llm_configuration.py to use.
# Defaults to 'gemini-2.5-flash' (or the fallback 'gemini-1.5-flash' if the first isn't defined).
# See backend/src/app/services/llm/llm_configuration.py for available keys.
# LLM_CONFIG_KEY=gpt-4o

# Select the interface to use ('openai' or 'pydantic'). Pydantic uses the configuration above.
LLM_INTERFACE=pydantic # Or 'openai' to use the OpenAI service directly

# The specific model name (used by OpenAI interface, ignored by Pydantic interface if LLM_CONFIG_KEY is set)
LLM_MODEL=gpt-4o

# Required API Keys (only needed for the provider selected by LLM_CONFIG_KEY or the default if using pydantic interface):
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"        # Required if using 'openai' provider (e.g., gpt-4o, gpt-4o-mini) OR if LLM_INTERFACE=openai
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"        # Required if using 'google-gla' provider (e.g., gemini-1.5-flash)
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"  # Required if using 'anthropic' provider (e.g., claude-3-5-sonnet)

# Note: If using 'google-vertex' provider via pydantic interface, ensure Application Default Credentials (ADC)
# are configured correctly (e.g., via gcloud auth application-default login) or set
# GOOGLE_APPLICATION_CREDENTIALS to point to your service account JSON file.
# You might also need to set PROJECT_ID, REGION, etc., depending on Vertex setup.


# -------------------------
# EMBEDDING CONFIG
# -------------------------
DIMENSIONS=1536
EMBEDDING_PROVIDER=openai # Currently only 'openai' supported for embeddings
EMBEDDING_MODEL=text-embedding-3-small # Specify the embedding model

# OpenAI API Key is also used for embeddings if EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY is defined under LLM CONFIG

# -------------------------
# VECTOR DATABASE CONFIG
# -------------------------
VECTOR_DB_PROVIDER=milvus
INDEX_NAME=knowledge_table

# -------------------------
# Milvus Config
# Applicable if VECTOR_DB_PROVIDER=milvus-lite
# -------------------------
MILVUS_DB_URI=./milvus_demo.db
MILVUS_DB_TOKEN={your-milvus-token}

# -------------------------
# Qdrant Config
# Applicable if VECTOR_DB_PROVIDER=qdrant
# -------------------------

# QDRANT_LOCATION="http://localhost:6333"
# QDRANT_PORT=
# QDRANT_GRPC_PORT=
# QDRANT_PREFER_GRPC=
# QDRANT_URL=
# QDRANT_HTTPS=
# QDRANT_API_KEY=
# QDRANT_PREFIX=
# QDRANT_TIMEOUT=
# QDRANT_HOST=
# QDRANT_PATH=

# -------------------------
# QUERY CONFIG
# -------------------------

QUERY_TYPE=hybrid

# -------------------------
# DOCUMENT PROCESSING CONFIG
# -------------------------
LOADER=pypdf
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# -------------------------
# UNSTRUCTURED CONFIG
# -------------------------

UNSTRUCTURED_API_KEY={your-unstructured-api-key}

# -------------------------
# LOGFIRE CONFIG (Optional)
# -------------------------
LOGFIRE_TOKEN={your-logfire-token} # Your Logfire Token (keep secret)